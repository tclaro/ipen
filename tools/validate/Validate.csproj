<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <!-- Aponta para os outputs de Release da solucao principal. Rode
       "msbuild CBT.sln /t:Rebuild /p:Configuration=Release" na raiz do
       repositorio antes de compilar este harness. -->
  <ItemGroup>
    <Reference Include="Ipen.CompartimentalModel">
      <HintPath>..\..\Ipen.CompartimentalModel\bin\Release\Ipen.CompartimentalModel.dll</HintPath>
    </Reference>
    <Reference Include="Ipen.SSID.UI">
      <HintPath>..\..\Ipen.SSID.UI\bin\Release\Ipen.SSID.UI.exe</HintPath>
    </Reference>
    <Reference Include="DotNumerics">
      <HintPath>..\..\Ipen.SSID.UI\bin\Release\DotNumerics.dll</HintPath>
    </Reference>
    <Reference Include="ZedGraph">
      <HintPath>..\..\Ipen.SSID.UI\bin\Release\ZedGraph.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

</Project>
